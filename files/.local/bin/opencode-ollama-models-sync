#!/usr/bin/env python3

import json
import subprocess
from pathlib import Path

config_file = Path.home() / ".config" / "opencode" / "opencode.json"

# Get Ollama models
print("Fetching Ollama models...")
result = subprocess.run(["ollama", "ls"], capture_output=True, text=True, check=True)
models = {line.split()[0]: {"name": line.split()[0]} for line in result.stdout.strip().split('\n')[1:] if line.strip()}
print(f"Found {len(models)} model(s)")

# Update config
print("Updating config...")
with open(config_file, 'r') as f:
    config = json.load(f)

# Ensure provider.ollama structure exists
if "provider" not in config:
    config["provider"] = {}
if "ollama" not in config["provider"]:
    config["provider"]["ollama"] = {}

# Set default properties if missing
config["provider"]["ollama"].setdefault("npm", "@ai-sdk/openai-compatible")
config["provider"]["ollama"].setdefault("name", "Ollama (local)")
config["provider"]["ollama"].setdefault("options", {"baseURL": "http://localhost:11434/v1"})
config["provider"]["ollama"]["models"] = models

# Write directly
with open(config_file, 'w') as f:
    json.dump(config, f, indent=2)
print("Done")
