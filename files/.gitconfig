[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[user]
  name = Alex Danilenko
  email = opensource@danilenko.in
  signingkey = ~/.ssh/id_ed25519.pub

[commit]
    gpgsign = true

# [includeIf "gitdir:~/Work/"]
#     path = ~/Work/.gitconfig

[core]
  autocrlf   = input
  safecrlf   = false
  ignorecase = false
  longpaths  = true
  editor     = nano
  excludesfile =

[diff]
  renames    = copies
  tool       = meld

[difftool]
  prompt     = false

[merge]
  tool       = meld

[mergetool]
  keepBackup = false
  prompt     = false

[color]
  ui         = true
  diff       = auto
  status     = auto
  branch     = auto

[alias]
  a          = apply --index
  c          = commit -m
  fa         = fetch --all
  ff         = !git pull origin $(git branch --show-current) --ff-only
  hidden     = !git ls-files -v | grep "^[[:lower:]]"
  hide       = update-index --assume-unchanged
  history    = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  last       = log -1 HEAD --stat
  ls         = log --stat
  p          = "!git pull origin $(git branch --show-current) --rebase --autostash"
  pd         = pull origin develop --rebase --autostash
  pm         = pull origin main --rebase --autostash
  pmm        = pull origin master --rebase --autostash
  s          = status --short --branch
  unhide     = update-index --no-assume-unchanged

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[fetch]
  prune = true
